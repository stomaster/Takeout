<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qtc.ecommerce_demo.mapper.UserMapper">

    <!-- 只保留一个 insert 标签 -->
    <insert id="insert" parameterType="com.qtc.ecommerce_demo.entity.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password, email, create_time, update_time)
        VALUES (#{username}, #{password}, #{email}, NOW(), NOW())
    </insert>

</mapper>

        <!--  parameterType="com.qtc.ecommerce_demo.entity.User"：

         指定传入参数的类型

         UserMapper里是int insert(User user)

         这里是 User实体类的完整类名

         表示这个方法接收一个 User对象作为参数

         在 SQL 中可以通过 #{属性名}访问对象的属性


         useGeneratedKeys="true"：

         启用数据库的自动生成主键功能

         适用于数据库自动递增的主键（如 MySQL 的 AUTO_INCREMENT）

         告诉 MyBatis 要获取数据库生成的主键值


         keyProperty="id"：

         指定将自动生成的主键值设置到哪个属性中

         这里设置为 User对象的 id属性

         执行插入后，生成的 ID 会自动填充到 user.id中-->